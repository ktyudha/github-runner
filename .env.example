TZ=Asia/Jakarta
RUNNER_IMAGE_TAG=latest

# Runner untuk satu repo -> RUNNER_SCOPE=repo + isi REPO_URL
# Runner untuk organisasi -> RUNNER_SCOPE=org  + isi ORG_NAME
RUNNER_SCOPE=repo
REPO_URL=https://github.com/OWNER/REPO
ORG_NAME=

# PAT (repo: scope "repo"; org: "admin:org")
ACCESS_TOKEN=

RUNNER_NAME=self-hosted-runner
RUNNER_LABELS=self-hosted,docker
RUNNER_GROUP=
# isi 1 untuk mode ephemeral (1 job lalu runner hilang)
EPHEMERAL=

# Folder kerja job. Dipakai dengan path yang sama di host dan container.
WORK_DIR=/opt/github-runner/work

# DNS untuk container
DNS1=1.1.1.1
DNS2=8.8.8.8
