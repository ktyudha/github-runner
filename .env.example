TZ=Asia/Jakarta
# 'latest' = rilis terbaru saat build, atau isi versi tertentu (minimal 2.329.0)
RUNNER_VERSION=latest

# URL repo (https://github.com/user/repo) atau org (https://github.com/org)
GITHUB_URL=https://github.com/OWNER/REPO

# Pilih salah satu:
# 1) PAT (repo: scope "repo"; org: "admin:org") -> token registrasi diambil otomatis
ACCESS_TOKEN=
# 2) Registration token manual (kedaluwarsa 1 jam, hanya untuk start pertama)
REGISTRATION_TOKEN=

RUNNER_NAME=self-hosted-runner
RUNNER_LABELS=self-hosted,docker
RUNNER_GROUP=
# isi 1 untuk mode ephemeral (1 job lalu runner hilang)
EPHEMERAL=

# DNS untuk container (jika resolver host tidak bisa dipakai container)
DNS1=1.1.1.1
DNS2=8.8.8.8
